---
import { formatPriceEUR } from "@/lib/products";

interface Props {
  index: number;
  eyebrow: string;
  title: string;
  description: string;
  priceCents?: number;
  stock?: number;
  isProduct?: boolean;
  sku?: string;
}

const { index, eyebrow, title, description, priceCents, stock, isProduct = false, sku } =
  Astro.props;
const outOfStock = isProduct && (stock ?? 0) <= 0;
---

<article class="story__stage" data-stage-index={index} data-sku={sku} aria-hidden="true">
  <div class="flex items-center gap-2 mb-2">
    <span class="w-6 h-px bg-brass" aria-hidden="true"></span>
    <span class="eyebrow">{eyebrow}</span>
  </div>
  <h2
    class="font-serif-italic font-medium leading-[1.05] text-bone text-[clamp(2.1rem,6vw,3.6rem)]"
    set:html={title}
  />
  <p class="mt-3 text-bone-dim text-[0.95rem] leading-relaxed not-italic font-sans max-w-md">
    {description}
  </p>
  {
    isProduct && (
      <div class="flex items-center gap-3 mt-4 flex-wrap">
        <span
          class:list={[
            "flex items-center gap-2 border px-3 py-1.5 font-mono text-[0.74rem]",
            outOfStock ? "border-rust text-rust" : "border-line bg-ink/50 text-bone-dim",
          ]}
        >
          <span
            data-price
            class:list={["tabular-nums", outOfStock ? "line-through text-rust" : "text-bone"]}
          >
            {outOfStock ? "Agotado" : formatPriceEUR(priceCents ?? 0)}
          </span>
        </span>
      </div>
    )
  }
</article>
