{
  "name": "zbe-calculadora-financiacion",
  "productName": "Calculadora ZBE",
  "version": "1.0.0",
  "description": "Calculadora de financiación para proyectos de Zonas de Bajas Emisiones (ZBE) — SYNERGY",
  "author": "SYNERGY",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.synergy.zbe-calculadora",
    "productName": "Calculadora ZBE",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "fonts/**/*",
      "!fonts/*.md"
    ],
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "icon": "build/icons",
      "category": "Office",
      "maintainer": "SYNERGY"
    }
  }
}
